{
  "name": "benchrun",
  "version": "1.0.0",
  "description": "Zero-dep microbenchmark runner for Node.js — define suites, run them, get stats",
  "main": "dist/index.js",
  "bin": {
    "benchrun": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules dist/test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "benchmark",
    "performance",
    "microbenchmark",
    "cli",
    "stats"
  ],
  "author": "sulthonzh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sulthonzh/benchrun"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/cli.js",
    "dist/cli.d.ts",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/sulthonzh/benchrun",
  "bugs": {
    "url": "https://github.com/sulthonzh/benchrun/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  }
}
